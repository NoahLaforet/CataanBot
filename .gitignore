# Project-local state
logs/
*.log
data/
# Rendered boards, histograms, advisor overlays live at the repo root.
# Ignore them there without hiding example PNGs checked in under subdirs.
/*.png

# colonist WS capture dumps — session-specific, large, often noisy.
ws_captures/

# Per-session postmortem HTML — auto-generated when a live game ends.
# Useful locally for reviewing a specific game, but not meant to be
# checked in (each file is tied to one finished session).
postmortems/

# Feedback log written by the bridge when the user clicks 👍/👎 on a
# rec. Contains rec content + per-game state hints — personal
# gameplay data that doesn't belong in a public repo.
feedback/

# Auto-saved WS frames for mid-game resume after a bridge restart or
# page refresh. Per-session live data; not for the public repo.
sessions/

# Personal scratch notes — useful for local development context but
# not meant for the public repo. Kept locally; ignored from git so
# they don't clutter the project's docs surface.
RESUME.md
TODO_VISUAL.md

# Raw gameplay clip exports used to produce the docs/media GIFs. Tens of
# MB of source video / images; the polished -wide variants shown in the
# README already live under docs/media/, so the raw exports stay local.
CatanBot Gameplay clips/

# Dev HUD harness (dev/hud/): the harness page, no-cache server, and
# fixture dumper are committed, but the generated snapshot fixtures
# (derived from ws_captures via dump_hud_fixtures.py) and the rendered
# screenshots / Playwright scratch are throwaway local artifacts.
dev/hud/fixtures/
/.playwright-mcp/
/hud-*.png

# Signing / notarization secrets: Developer ID identity, Apple ID, team id,
# app-specific password. Real values live in .env (never committed); the
# committed .env.example documents the keys.
.env
graphify-out/
