# Copy to .env (gitignored) and fill in your real values. Never commit .env.
# Used by scripts/sign_and_notarize.sh to Developer ID sign + notarize the
# self-contained CatanBot.app so a downloaded copy opens by double-click.

# Your "Developer ID Application" identity, EXACTLY as printed by:
#   security find-identity -v -p codesigning
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# 10-character Apple Developer Team ID (developer.apple.com > Membership).
TEAM_ID="XXXXXXXXXX"

# Apple ID email used for notarization.
APPLE_ID="you@example.com"

# App-specific password from appleid.apple.com (Sign-In & Security >
# App-Specific Passwords). NOT your normal Apple ID password.
APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Local name for the stored notarytool credential profile (any string).
NOTARY_PROFILE="catanbot-notary"
