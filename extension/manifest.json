{
  "manifest_version": 3,
  "name": "CataanBot — Colonist HUD",
  "short_name": "CataanBot",
  "version": "0.32.0",
  "description": "Side-panel HUD for colonist.io. Full-feature port of the Tampermonkey userscript v0.25.4 — recommendations, robber targets, knight/monopoly/YoP/RB hints, plan banner, threat banner, win-this-turn callout, eval sparkline, roll histogram, move-quality strip — all in Chrome's side panel.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://colonist.io/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://colonist.io/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://colonist.io/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open CataanBot side panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
